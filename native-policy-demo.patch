+        robot = np.concatenate([self.obs["robot0_joint_pos"], self.obs["robot0_eef_pos"],
+            quat2axisangle(self.obs["robot0_eef_quat"]), self.obs["robot0_gripper_qpos"]]).astype(np.float32)
+        return {"jpeg": file.read_bytes(), "robot": robot}
